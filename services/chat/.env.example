# Chat service
CHAT_SERVICE_HOST=0.0.0.0
CHAT_SERVICE_PORT=8004
CHAT_LOG_LEVEL=INFO

# PostgreSQL
CHAT_DATABASE_URL=postgresql+asyncpg://chat:chat@localhost:5432/chat

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Agent
CHAT_AGENT_MAX_TOOL_ROUNDS=8
CHAT_CONVERSATION_HISTORY_LIMIT=20

# Internal Chat gRPC service authentication
CHAT_SERVICE_NAME=chat
CHAT_SERVICE_SECRET=replace-with-a-strong-chat-service-secret
CHAT_CALLER_SERVICE_NAME=store
CHAT_CALLER_SERVICE_SECRET=replace-with-the-same-secret-configured-for-store

# Internal downstream gRPC addresses (configure for your environment)
EMBEDDING_SERVICE_ADDR=localhost:8092
EMBEDDING_SERVICE_NAME=chat
EMBEDDING_SERVICE_SECRET=

PRODUCT_SERVICE_ADDR=
PRODUCT_SERVICE_NAME=product
PRODUCT_SERVICE_SECRET=

CHAT_SYSTEM_PROMPT_FILE=prompts/system.md
CHAT_GRPC_MAX_WORKERS=10
