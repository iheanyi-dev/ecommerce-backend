APP_ENV=development
APP_PORT=8082
GRPC_PORT=9094

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=store
DATABASE_PASSWORD=store
DATABASE_NAME=store
DATABASE_SSL_MODE=disable

SERVICE_AUTH_NAME=store
SERVICE_AUTH_SECRET=store-test-service-secret
KAFKA_BROKERS=localhost:19092
BILLING_STORE_EVENTS_TOPIC=billing.subscription.events

# Store-to-Chat gRPC connection
CHAT_SERVICE_ADDR=localhost:9092
CHAT_SERVICE_NAME=chat
CHAT_SERVICE_SECRET=store-chat-development-secret

# Store-to-Product gRPC connection
PRODUCT_SERVICE_ADDR=localhost:9091
PRODUCT_SERVICE_NAME=product
PRODUCT_SERVICE_SECRET=store-product-development-secret

# Store-to-Storage gRPC connection
STORAGE_SERVICE_ADDR=localhost:9082

# Store-to-Recommendation gRPC connection
RECOMMENDATION_SERVICE_ADDR=localhost:8090
RECOMMENDATION_SERVICE_NAME=recommendation
RECOMMENDATION_SERVICE_SECRET=replace-with-recommendation-service-secret
ORDER_SERVICE_ADDR=localhost:9093
ORDER_SERVICE_NAME=order
ORDER_SERVICE_SECRET=replace-with-a-strong-order-service-secret

# Billing subscription events consumed by Store
BILLING_STORE_EVENTS_TOPIC=billing.subscription.events
STORE_SUBSCRIPTION_CONSUMER_GROUP=store-subscription-updates
