# Cart HTTP server
HTTP_ADDR=:8090

# Internal Cart gRPC server
GRPC_ADDR=:9092

# Cart service environment variables

# Redis
REDIS_ADDR=localhost:6379
REDIS_DB=0
# Replace this placeholder in your local .env file.
REDIS_PASSWORD=replace-with-a-strong-random-password

# Product gRPC service
PRODUCT_SERVICE_ADDR=localhost:9091

# Service-to-service authentication
SERVICE_AUTH_NAME=cart
# Replace this placeholder with the configured Cart service secret.
SERVICE_AUTH_SECRET=replace-with-a-strong-random-service-secret

# Credentials Cart expects from the Order service over internal gRPC
ORDER_SERVICE_AUTH_NAME=order
ORDER_SERVICE_AUTH_SECRET=replace-with-a-strong-order-service-secret
