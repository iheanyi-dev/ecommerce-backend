ORDER_HTTP_PORT=8094\nAPP_ENV=development

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=order
DATABASE_PASSWORD=change-me
DATABASE_NAME=order
DATABASE_SSL_MODE=disable

# Optional: dedicated Order PostgreSQL integration-test database URL.
# Leave empty to skip integration tests; never point this at another database.
ORDER_TEST_DATABASE_URL=

# Internal Cart gRPC client
CART_SERVICE_ADDR=localhost:9092
ORDER_SERVICE_AUTH_NAME=order
ORDER_SERVICE_AUTH_SECRET=replace-with-a-strong-order-service-secret

# Internal Order gRPC server (called by Store)
ORDER_GRPC_ADDR=:9093
STORE_SERVICE_AUTH_NAME=store
STORE_SERVICE_AUTH_SECRET=replace-with-a-strong-store-service-secret

# Payment status events
KAFKA_BROKERS=localhost:9092
PAYMENT_EVENTS_TOPIC=payment.events
ORDER_PAYMENT_CONSUMER_GROUP=order-payment-consumer

# Internal Payment service gRPC address
PAYMENT_SERVICE_ADDR=localhost:9095

# Internal Identity gRPC address
IDENTITY_SERVICE_ADDR=localhost:9090
