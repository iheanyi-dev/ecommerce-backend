APP_ENV=development
APP_PORT=8083
GRPC_PORT=9091
GRPC_SERVICE_AUTH_NAME=product
GRPC_SERVICE_AUTH_SECRET=store-product-development-secret

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=product
DATABASE_PASSWORD=replace-with-product-database-password
DATABASE_NAME=product
DATABASE_SSL_MODE=disable
STORAGE_SERVICE_ADDR=localhost:9082
STORE_SERVICE_ADDR=localhost:9091
SERVICE_AUTH_NAME=gateway
SERVICE_AUTH_SECRET=REPLACE_WITH_THE_PRODUCT_SERVICE_SECRET
KAFKA_BROKERS=localhost:19092

# Promotion events consumed by Product
PROMOTION_EVENTS_TOPIC=promotion.events
PRODUCT_PROMOTION_CONSUMER_GROUP=product-promotion-consumer
