APP_ENV=development
APP_PORT=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_NAME=e-identity-db
DATABASE_SSL_MODE=disable
SERVICE_AUTH_NAME=gateway
SERVICE_AUTH_SECRET=
JWT_SECRET=your-development-secret
JWT_ISSUER=identity-service
JWT_ACCESS_TOKEN_TTL=15m
# PostgreSQL container bootstrap configuration.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Account activation configuration.
ACTIVATION_URL=http://localhost:3000/activate
ACTIVATION_TOKEN_TTL=24h

# Account activation email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
ACTIVATION_URL=
ACTIVATION_TOKEN_TTL=24h
